# =============================================================================
# /opt/informix-proxy/.env - staging deployment
#
# Copy to /opt/informix-proxy/.env and adjust. INFORMIX_PROXY_IMAGE is
# overwritten on every CI deploy (set to the exact signed digest that run
# just verified) - the value here only matters for the very first manual
# `docker compose up -d` before CI has deployed anything.
# =============================================================================

INFORMIX_PROXY_IMAGE=ghcr.io/postarodiy/informix-proxy:latest

GRPC_PORT=50051
METRICS_PORT=9090

POOL_MAX_SIZE=20
POOL_MIN_IDLE=5
POOL_CONNECTION_TIMEOUT_MS=30000
POOL_IDLE_TIMEOUT_MS=600000
POOL_MAX_LIFETIME_MS=1800000

JAVA_OPTS=-Xmx2g -Xms1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp
