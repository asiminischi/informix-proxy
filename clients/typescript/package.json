{
  "name": "@postarodiy/informix-client",
  "version": "0.1.0",
  "description": "Typed Node.js/TypeScript client for informix-proxy's gRPC service",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postarodiy/informix-proxy.git",
    "directory": "clients/typescript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "proto"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "prebuild": "node scripts/generate-proto.mjs",
    "pretypecheck": "node scripts/generate-proto.mjs",
    "pretest": "node scripts/generate-proto.mjs",
    "build": "npm run prebuild && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "protobufjs-cli": "^2.6.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
