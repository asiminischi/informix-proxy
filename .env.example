###############################################################################
# Informix gRPC Proxy - Environment Configuration
#
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# NEVER commit .env to version control (already in .gitignore).
###############################################################################

# --- Local dev/test Informix database (docker-compose.dev.yml only) --------
# The proxy itself never holds database credentials: each client supplies
# host/port/database/username/password in the Connect RPC. These two values
# only name the optional local test database container used for development.
INFORMIX_SERVER=informix
INFORMIX_DB=testdb

# ─── Connection Pool ────────────────────────────────────────────────────────
POOL_MAX_SIZE=20
POOL_MIN_IDLE=5
POOL_CONNECTION_TIMEOUT_MS=30000
POOL_IDLE_TIMEOUT_MS=600000
POOL_MAX_LIFETIME_MS=1800000

# ─── gRPC Proxy ─────────────────────────────────────────────────────────────
GRPC_PORT=50051
METRICS_PORT=9090

# ─── JVM Tuning ─────────────────────────────────────────────────────────────
JAVA_OPTS=-Xmx2g -Xms1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp

# ─── Grafana ─────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
